# Copy to .env. Generate a password hash with: python scripts/setup_admin.py
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
# Generate using cryptography.fernet.Fernet.generate_key(). Keep stable and backed up.
ENCRYPTION_KEY=
# Set true behind production HTTPS.
SECURE_COOKIES=false
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Explicit HTTPS DNS host allowlist; no URLs, wildcards, credentials, or private hosts.
ALLOWED_PROVIDER_HOSTS=
# Defaults resolve from project root. Override in containers.
# DATABASE_URL=sqlite:///./runtime/polylingo.db
# ADAPTER_PATH=models/polyligo_nllb_lora/best_adapter
# HF_CACHE=data/hf_cache/hub
MAX_UPLOAD_MB=15
SESSION_HOURS=8
# Seconds a request may wait for another model operation to finish.
INFERENCE_QUEUE_TIMEOUT=30
AUTO_TRANSLATE_VOICE=true
TRANSCRIPT_CORRECTION_ENABLED=true
TRANSCRIPT_CORRECTION_PROVIDER=hybrid
CORRECTION_CONFIDENCE_THRESHOLD=0.95
# Optional Hugging Face cache for Whisper; use the same value when downloading and serving.
# WHISPER_CACHE=runtime/whisper-cache

